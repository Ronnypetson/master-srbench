FROM srbench/base:latest

# Build argument for algorithm name
ARG ALGORITHM=pysr

# Switch to root for installation
USER root

# conda-forge julia's libgit2 needs OpenSSL + CA certs to initialize; without
# them every `julia` invocation exits 1 and pysr.install() fails. The base
# image doesn't ship these, and its rebuild workflow is disabled, so install
# them here.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates openssl libssl3 && \
    rm -rf /var/lib/apt/lists/*

# Copy install script and algorithm files
COPY scripts/install_algorithm.sh /install/install_algorithm.sh
COPY base_environment.yml /install/base_environment.yml
COPY algorithms/${ALGORITHM} /install/algorithms/${ALGORITHM}

# Set temp directory to /tmp to avoid permission issues
ENV TMPDIR=/tmp

# Run installation
WORKDIR /install
RUN eval "$(micromamba shell hook --shell bash)" && \
    micromamba activate base && \
    bash install_algorithm.sh "/install/algorithms/${ALGORITHM}" && \
    which julia && \
    julia --version && \
    micromamba clean --all --yes && \
    mkdir -p /srbench

# Set environment
ENV ALGORITHM=${ALGORITHM}
ENV LD_LIBRARY_PATH=/opt/conda/lib:${LD_LIBRARY_PATH:-}

# Default working directory
WORKDIR /srbench

# Entrypoint that activates micromamba
ENTRYPOINT ["/bin/bash", "-c", "eval \"$(micromamba shell hook --shell bash)\" && micromamba activate base && cd /srbench && exec \"$@\"", "--"]
CMD ["bash"]
